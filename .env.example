# Wyscout credentials (required)
WYSCOUT_EMAIL=your_email@example.com
WYSCOUT_PASSWORD=your_password
WYSCOUT_GROUP_ID=1059060
WYSCOUT_SUBGROUP_ID=93476
WYSCOUT_TOKEN=          # auto-filled by token_manager.py

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/football_platform

# Optional: SofaScore enrichment
SOFASCORE_RATE_LIMIT=1.5

# Optional: Transfermarkt enrichment
TRANSFERMARKT_RATE_LIMIT=4.0
